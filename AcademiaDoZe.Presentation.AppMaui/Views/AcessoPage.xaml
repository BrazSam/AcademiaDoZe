<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AcessoPage"
 xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
 xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
 x:DataType="vm:AcessoViewModel"
 Title="{Binding Title}">
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20" MaximumWidthRequest="520">

            <!-- Cabeçalho: logo + relógio -->
            <Image Source="{AppThemeBinding Light=academiadozelight.png, Dark=academiadoze.png}"
                   HeightRequest="110" WidthRequest="110" HorizontalOptions="Center"/>
            <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                <Label Text="{Binding HoraAtual}" FontSize="52" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="{Binding DataAtual}" FontSize="16" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
            </VerticalStackLayout>

            <!-- CPF -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Digite seu CPF" FontSize="16" HorizontalOptions="Center"/>
                    <Entry x:Name="CpfEntry" Text="{Binding Cpf}" Placeholder="000.000.000-00"
                           Keyboard="Numeric" MaxLength="14" FontSize="28" HorizontalTextAlignment="Center"
                           ReturnCommand="{Binding RegistrarCommand}"/>
                    <Button Text="Registrar" Command="{Binding RegistrarCommand}" Style="{StaticResource ButtonPrimary}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xea77;" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Center"/>

            <!-- Boas-vindas: borda verde na entrada, roxa na saída -->
            <Border Style="{StaticResource CardBorder}" StrokeThickness="3" Padding="20" IsVisible="{Binding MostrarBoasVindas}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsEntrada}" Value="True">
                        <Setter Property="Stroke" Value="#2E7D32"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsEntrada}" Value="False">
                        <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <!-- Foto redonda; sem foto, mostra as iniciais -->
                    <Grid WidthRequest="120" HeightRequest="120" HorizontalOptions="Center">
                        <Border StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="{StaticResource Secondary}">
                            <Label Text="{Binding Iniciais}" FontSize="40" FontAttributes="Bold"
                                   TextColor="{StaticResource Tertiary}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Border StrokeShape="Ellipse" StrokeThickness="0" IsVisible="{Binding TemFoto}">
                            <Image Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}" Aspect="AspectFill"/>
                        </Border>
                    </Grid>
                    <Label Text="{Binding Saudacao}" FontSize="28" FontAttributes="Bold"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding Papel}" FontSize="16" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                    <!-- Selo "Entrada · 08:15" / "Saída · 09:40" -->
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="18,6" HorizontalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsEntrada}" Value="True">
                                <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsEntrada}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Movimento}" FontSize="18" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="True">
                                    <Setter Property="TextColor" Value="#1B5E20"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource Tertiary}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Label Text="{Binding Mensagem}" FontSize="18" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Acesso negado -->
            <Border Style="{StaticResource CardBorder}" Stroke="#C62828" StrokeThickness="3" Padding="20" IsVisible="{Binding MostrarNegado}">
                <VerticalStackLayout Spacing="8">
                    <Label FontFamily="MaterialIcons" Text="&#xe897;" FontSize="48" TextColor="#C62828" HorizontalOptions="Center"/>
                    <Label Text="Acesso negado" FontSize="28" FontAttributes="Bold" TextColor="#C62828" HorizontalOptions="Center"/>
                    <Label Text="{Binding Mensagem}" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>